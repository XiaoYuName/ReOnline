    <tags>excel xlsx csv micro-helper mini openxml helper</tags>
    <repository type="Github" url="https://github.com/mini-software/MiniExcel" branch="refs/heads/v1.x-maintenance" commit="1894f4b6e385631097eaaf8c55c34447ca707507" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework=".NETFramework4.5" />
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.IO.Compression" targetFramework=".NETFramework4.5" />
    </frameworkAssemblies>
  </metadata>
