<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Luban 的 ByteBuf（vendored 在 Luban/Runtime/）里有两个 *_Unsafe 优化方法用了指针。
      开这个开关是为了让 vendored 文件和上游**逐字节一致**，升级时直接覆盖即可，不用重打补丁。
      wasm 里的指针操作出不了线性内存沙箱，也不影响 Reducer 的确定性。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.')) Or '$(EXPERIMENTAL_WASM_AOT)' == '1'">
    <!--
      AOT 模式下产物是 library：SpacetimeDB 的源生成器把 Main 标成
      [UnmanagedCallersOnly(EntryPoint = "__preinit__10_init_csharp")] 作为 preinit 导出，
      而 UnmanagedCallersOnly 不允许标在应用程序入口点上（CS8899）。
      SelfContained=true 会让 SDK 把 OutputType 推成 Exe，所以这里必须显式压回 Library。
      spacetime init 针对 .NET 10 生成的模板漏了这一行。
    -->
    <OutputType>Library</OutputType>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>

    <RestoreAdditionalProjectSources>https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;https://api.nuget.org/v3/index.json;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.Runtime" Version="2.8.*" />
  </ItemGroup>

  <!--
    Luban 导出的配置数据（Configs/*.bytes）以**嵌入资源**编进 wasm。
    模块跑在数据库进程内、没有文件系统，这是唯一能把配置带进去的方式。
    实测 GetManifestResourceStream 在 wasi-wasm + NativeAOT + 裁剪下可用。
    ⇒ 改了配置必须重新 gen_server.bat + spacetime publish 才生效。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Configs\**\*.bytes" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.'))">
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-*" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-*" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.')) And '$(EXPERIMENTAL_WASM_AOT)' == '1'">
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="8.0.0-*" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="8.0.0-*" />
  </ItemGroup>

</Project>
